{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group Playwright packages and Docker image",
      "matchDatasources": ["npm", "docker"],
      "matchPackageNames": [
        "mcr.microsoft.com/playwright",
        "playwright",
        "@playwright/**"
      ],
      "groupName": "playwright",
      "groupSlug": "playwright",
      "prCreation": "not-pending"
    },
    {
      "description": "Keep Playwright npm and Docker updates grouped while waiting for the npm cooldown",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["playwright", "@playwright/**"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "none"
    }
  ]
}
